```json
{
  "id": "uuid",
  "timestamp_start": "2026-04-30T10:00:00",
  "timestamp_end": "2026-04-30T12:00:00",
  "transcript": "...",
  "categories": ["Debugging"],
  "summary": "..."
}
```

